# ------------------------------------------------------------------
# FUTURE ENGLISH CENTER — backend environment
# Copy to backend/.env and adjust. Never commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection string.
#  - Real PostgreSQL:  postgresql://USER:PASSWORD@localhost:5432/future_english?schema=public
#  - Bundled local dev DB (`npm run db:local`, PGlite on port 5433, single connection):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pool_timeout=30&pgbouncer=true"

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Generate long random strings, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14

# AI tutor (server-side only). Provider: gemini | openai | none
# With "none" (or no key) the tutor uses the built-in offline knowledge engine.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
